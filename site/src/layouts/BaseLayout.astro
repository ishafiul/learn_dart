---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
};

const { title, description, canonicalPath, ogType = "website" } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = canonicalPath ? `${site}${canonicalPath}` : new URL(Astro.url.pathname, site).toString();
const desc =
  description ??
  "Learn Dart and Flutter with structured roadmaps, lessons, and hands-on builds — static, fast, and SEO-friendly.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Learn Dart & Flutter",
        url: site || canonical,
        description: desc,
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
